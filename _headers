# _headers dal kit (verificato dal vivo su Franco). UN SOLO blocco "/*": un secondo blocco lo sostituirebbe.
# Script in linea: solo document.documentElement.classList.add("js") in <head>, ammesso con il suo hash.
# Anteprima su *.pages.dev o *.workers.dev: aggiungere X-Robots-Tag: noindex, nofollow DENTRO il blocco "/*" e toglierlo al lancio.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U='; connect-src 'self'; form-action 'self'; frame-src 'none'; upgrade-insecure-requests

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000

/video/*
  Cache-Control: public, max-age=2592000

/css/*
  Cache-Control: public, max-age=86400, must-revalidate

/js/*
  Cache-Control: public, max-age=86400, must-revalidate
